# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgres://kumun:kumun2026@localhost:5432/kumun_delegation

# Set to "true" if your DB requires SSL (e.g., Neon, Supabase, Railway)
DATABASE_SSL=false

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_SECRET=change-this-to-a-long-random-string

# The public URL of your app (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# ─── Admin Credentials ───────────────────────────────────────────────────────
# Simple plaintext password (dev only). For production, use ADMIN_PASSWORD_HASH.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=kumun2026

# Production: generate bcrypt hash with: node -e "const b=require('bcryptjs'); b.hash('yourpass', 10).then(console.log)"
# ADMIN_PASSWORD_HASH=\$2b\$10\$...
